<section class="card chat-launch" data-block="chat" data-instance="{{ instance }}">
  <h3>{{ props.title|default('Chat') }}</h3>
  <p class="desc">Opens as a panel on the right. Fullscreen is always your choice.</p>
  <button class="btn primary small" type="button" data-chat="{{ props.agent|default('') }}">Open chat</button>
</section>
