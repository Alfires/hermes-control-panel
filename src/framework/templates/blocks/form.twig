<section class="card" data-block="form" data-instance="{{ instance }}">
  <h2>{{ props.title|default('Form') }}</h2>
  <form hx-post="/api.php" hx-trigger="submit">
    {% for field in props.fields|default([]) %}
      {% set f = field is iterable ? field : {'label': field, 'name': field} %}
      <label>{{ f.label|default(f.name|default('Field')) }}
        <input name="{{ f.name|default('field')|slug }}" value="{{ f.value|default('') }}">
      </label>
    {% endfor %}
    <button class="btn primary" type="submit">Save</button>
  </form>
</section>
